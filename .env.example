# Names only. Set real values in Vercel > Project > Settings > Environment Variables.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=            # comma-separated mailbox(es) that receive inquiries
INQUIRY_FROM_EMAIL=          # e.g. "KalBOLT <no-reply@kalbolt.com>" (domain must be verified in Resend)
DEV_SIMULATE_SUBMISSIONS=false  # local dev only; ignored in production
